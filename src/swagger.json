{
    "openapi": "3.0.0",
    "info": {
        "title": "MovieFlix API",
        "version": "1.0.0",
        "description": "API para gerenciamento de filmes e gêneros"
    },
    "servers": [
        {
            "url": "http://localhost:3000",
            "description": "Servidor local"
        }
    ],
    "paths": {
        "/movies": {
            "get": {
                "tags": ["Movies"],
                "summary": "Listar filmes",
                "description": "Retorna uma lista de filmes com seus gêneros",
                "responses": {
                    "200": {
                        "description": "Lista de filmes retornada com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Movie"
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Erro interno do servidor"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Movie": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "example": "Inception"
                    },
                    "genre_id": {
                        "$ref": "#/components/schemas/Genre",
                        "description": "Gênero do filme",
                        "type": "string"
                    },
                    "language_id": {
                        "$ref": "#/components/schemas/Language",
                        "description": "Idioma do filme",
                        "example": "English"
                    },
                    "oscar_count": {
                        "type": "integer",
                        "description": "Número de Oscars ganhos pelo filme",
                        "example": 4
                    },
                    "release_date": {
                        "type": "string",
                        "format": "date",
                        "description": "Data de lançamento do filme",
                        "example": "2010-07-16"
                    }
                }
            },
            "Genre": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Sci-Fi"
                    }
                }
            },
            "Language": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "English"
                    }
                }
            }
        }
    }
}